/* ================================================================
 * Low-level helpers
 * ================================================================ */
static uint8_t dthc_crc8(const uint8_t *data, uint32_t len)
{
    uint8_t crc = 0x00;
    while (len--) {
        uint8_t i;
        crc ^= *data++;
        for (i = 0; i < 8; i++) {
            if (crc & 0x80)
                crc = (uint8_t)((crc << 1) ^ 0x07);
            else
                crc <<= 1;
        }
    }
    return crc;
}

static uint8_t dthc_clamp_u8(unsigned value)
{
    return (value > 0xFFu) ? 0xFFu : (uint8_t)value;
}

static uint16_t dthc_get_u16(const uint8_t *src)
{
    return (uint16_t)(((uint16_t)src[0] << 8) | (uint16_t)src[1]);
}

static uint32_t dthc_get_u32(const uint8_t *src)
{
    return ((uint32_t)src[0] << 24)
         | ((uint32_t)src[1] << 16)
         | ((uint32_t)src[2] << 8)
         | (uint32_t)src[3];
}

static int32_t dthc_get_s24(const uint8_t *src)
{
    uint32_t value = ((uint32_t)src[0] << 16) |
                     ((uint32_t)src[1] << 8) | src[2];
    if (value & 0x00800000u) value |= 0xff000000u;
    return (int32_t)value;
}

static void dthc_put_u16(uint8_t *dst, uint16_t value)
{
    dst[0] = (uint8_t)(value >> 8);
    dst[1] = (uint8_t)(value & 0xFFu);
}

static void dthc_put_u32(uint8_t *dst, uint32_t value)
{
    dst[0] = (uint8_t)(value >> 24);
    dst[1] = (uint8_t)((value >> 16) & 0xFFu);
    dst[2] = (uint8_t)((value >> 8) & 0xFFu);
    dst[3] = (uint8_t)(value & 0xFFu);
}

static uint32_t dthc_crc32(const uint8_t *data, uint32_t length)
{
    uint32_t crc = 0xffffffffu;
    uint32_t i;
    for (i = 0; i < length; ++i) {
        uint32_t bit;
        crc ^= data[i];
        for (bit = 0; bit < 8u; ++bit)
            crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1u)));
    }
    return ~crc;
}

static uint32_t dthc_encode_uq16(double value)
{
    double scaled = value * 65536.0;
    if (scaled <= 0.0) return 0u;
    if (scaled >= 4294967295.0) return 0xffffffffu;
    return (uint32_t)(scaled + 0.5);
}

static uint32_t dthc_encode_u32(double value)
{
    if (value <= 0.0) return 0u;
    if (value >= 4294967295.0) return 0xffffffffu;
    return (uint32_t)(value + 0.5);
}

static uint8_t dthc_encode_fraction_q8(double value)
{
    if (value <= 0.0) return 0u;
    if (value >= 1.0) return 255u;
    return (uint8_t)(value * 255.0 + 0.5);
}

static uint16_t dthc_encode_q4(double value)
{
    double scaled = value * 16.0;
    if (scaled <= 0.0) return 0;
    if (scaled >= 65535.0) return 65535u;
    return (uint16_t)(scaled + 0.5);
}

static uint16_t dthc_encode_ms(double seconds)
{
    double scaled = seconds * 1000.0;
    if (scaled <= 0.0) return 0;
    if (scaled >= 65535.0) return 65535u;
    return (uint16_t)(scaled + 0.5);
}

static uint16_t dthc_encode_u16(double value)
{
    if (value <= 0.0) return 0;
    if (value >= 65535.0) return 65535u;
    return (uint16_t)(value + 0.5);
}

static uint16_t dthc_encode_s16(int32_t value)
{
    if (value > 32767) value = 32767;
    else if (value < -32768) value = -32768;
    return (uint16_t)(int16_t)value;
}

/* ================================================================
 * Frame I/O
 * ================================================================ */
static void dthc_build_frame(uint8_t *frame, uint8_t cmd,
                              const uint8_t *payload, uint8_t payload_len)
{
    uint8_t i;
    uint8_t frame_len = (uint8_t)(3 + payload_len);

    frame[0] = DTHC_SPI_SOF;
    frame[1] = frame_len;
    frame[2] = cmd;

    for (i = 0; i < payload_len; i++)
        frame[3 + i] = payload[i];

    frame[frame_len] = dthc_crc8(frame, frame_len);

    for (i = (uint8_t)(frame_len + 1); i < DTHC_SPI_PACKET_SIZE; i++)
        frame[i] = 0;
}

static void dthc_frame_to_tram(struct __comp_state *__comp_inst,
                                const uint8_t *frame)
{
    int i;
    for (i = 0; i < DTHC_SPI_TRAM_SLOTS; i++)
        *tram_write[i] = ((uint32_t)frame[i*4+0] << 24)
                       | ((uint32_t)frame[i*4+1] << 16)
                       | ((uint32_t)frame[i*4+2] <<  8)
                       | ((uint32_t)frame[i*4+3]);
}

static void dthc_tram_to_frame(struct __comp_state *__comp_inst,
                                uint8_t *frame)
{
    int i;
    for (i = 0; i < DTHC_SPI_TRAM_SLOTS; i++) {
        uint32_t w = *tram_read[i];
        frame[i*4+0] = (uint8_t)(w >> 24);
        frame[i*4+1] = (uint8_t)(w >> 16);
        frame[i*4+2] = (uint8_t)(w >>  8);
        frame[i*4+3] = (uint8_t)(w >>  0);
    }
}

static int dthc_validate_frame(const uint8_t *frame, uint8_t *cmd,
                                const uint8_t **payload, uint8_t *payload_len)
{
    uint8_t frame_len;

    if (frame[0] != DTHC_SPI_SOF)
        return DTHC_FRAME_BAD_SOF;

    frame_len = frame[1];
    if (frame_len < 3 || frame_len >= DTHC_SPI_PACKET_SIZE)
        return DTHC_FRAME_BAD_LENGTH;

    if (frame[frame_len] != dthc_crc8(frame, frame_len))
        return DTHC_FRAME_BAD_CRC;

    *cmd = frame[2];
    *payload = frame + 3;
    *payload_len = (uint8_t)(frame_len - 3);
    return DTHC_FRAME_OK;
}

/* ================================================================
 * Status decode
 * ================================================================ */
static void dthc_apply_status(struct __comp_state *__comp_inst, uint32_t status)
{
    status_code = status;
    status_fault          = (status & DTHC_STAT_FAULT)          ? 1 : 0;
    status_delay          = (status & DTHC_STAT_DELAY)          ? 1 : 0;
    status_tipsave_active = (status & DTHC_STAT_TIPSAVE_ACT)    ? 1 : 0;
    status_enabled        = (status & DTHC_STAT_ENABLED)        ? 1 : 0;
    status_tipsave_on     = (status & DTHC_STAT_TIPSAVE_ON)     ? 1 : 0;
    status_eeread_err     = (status & DTHC_STAT_EEREAD_ERR)     ? 1 : 0;
    status_eewrite_err    = (status & DTHC_STAT_EEWRITE_ERR)    ? 1 : 0;
    status_arcok_on       = (status & DTHC_STAT_ARCOK_ON)       ? 1 : 0;
    status_mtrvolt_high   = (status & DTHC_STAT_MTRVOLT_HIGH)   ? 1 : 0;
    status_mtrvolt_low    = (status & DTHC_STAT_MTRVOLT_LOW)    ? 1 : 0;
    status_mtrvolt_off    = (status & DTHC_STAT_MTRVOLT_OFF)    ? 1 : 0;
    status_gecko_fault    = (status & DTHC_STAT_GECKO_FAULT)    ? 1 : 0;
    status_eegood         = (status & DTHC_STAT_EEGOOD)         ? 1 : 0;
    status_torch_on       = (status & DTHC_STAT_TORCH_ON)       ? 1 : 0;
    status_hold           = (status & DTHC_STAT_HOLD)           ? 1 : 0;
    status_up             = (status & DTHC_STAT_UP)             ? 1 : 0;
    status_down           = (status & DTHC_STAT_DOWN)           ? 1 : 0;
    status_mtr_external   = (status & DTHC_STAT_MTR_EXTERNAL)   ? 1 : 0;
    status_test_mode      = (status & DTHC_STAT_TEST_MODE)      ? 1 : 0;
    status_wd_good        = (status & DTHC_STAT_WD_GOOD)        ? 1 : 0;
    status_as_sample_good = (status & DTHC_STAT_AS_SAMPLE_GOOD) ? 1 : 0;
    status_as_sample_bad  = (status & DTHC_STAT_AS_SAMPLE_BAD)  ? 1 : 0;
    status_profile_provisional = (status & DTHC_STAT_PROFILE_PROV) ? 1 : 0;
    status_velocity_stale = (status & DTHC_STAT_VELOCITY_STALE) ? 1 : 0;
    status_observer_active = (status & DTHC_STAT_OBSERVER_ACTIVE) ? 1 : 0;
    status_target_active = (status & DTHC_STAT_TARGET_ACTIVE) ? 1 : 0;
    status_slowdown_active = (status & DTHC_STAT_SLOWDOWN_ACTIVE) ? 1 : 0;
    status_profile_fault = (status & DTHC_STAT_PROFILE_FAULT) ? 1 : 0;
    status_down_lock = (status & DTHC_STAT_DOWN_LOCK) ? 1 : 0;
    status_has_autoset    = (status & DTHC_STAT_HAS_AUTOSET)    ? 1 : 0;
    status_debug          = (status & DTHC_STAT_DEBUG)          ? 1 : 0;
    fb_profile_provisional = status_profile_provisional;
    fb_profile_fault = status_profile_fault;
}

/* ================================================================
 * Reply parsers
 * ================================================================ */

static void dthc_stream_voltage_sample(struct __comp_state *__comp_inst,
                                       uint32_t sample_tick,
                                       uint16_t packed, unsigned v3)
{
    union hal_stream_data sample[21];
    if (!logging_enable || !logging_compatible || !dthc_voltage_stream_ready)
        return;

    sample[0].u = sample_tick;
    sample[1].u = trace_tick;
    /* Bits 0..2: torch, ArcOK, sampled THC enable. */
    sample[2].u = ((packed >> 15) & 1u) |
                  (((packed >> 14) & 1u) << 1) |
                  ((v3 ? ((packed >> 13) & 1u) : 0u) << 2);
    sample[3].f = logging_xy_velocity_commanded;
    sample[4].f = logging_xy_velocity_realtime;
    sample[5].f = (double)(packed & (v3 ? 0x1FFFu : 0x3FFFu)) / 16.0;
    sample[6].f = trace_base_target;
    sample[7].f = trace_adjusted_target;
    sample[8].f = trace_target_candidate;
    sample[9].f = trace_g_hat_mm;
    sample[10].f = trace_w_hat_mm_s;
    sample[11].f = trace_residual_mm;
    sample[12].f = trace_feedback_mm_s;
    sample[13].f = trace_feedforward_mm_s;
    sample[14].f = trace_request_mm_s;
    sample[15].f = trace_realized_mm_s;
    sample[16].f = trace_confidence;
    sample[17].f = trace_load;
    sample[18].f = trace_rxy;
    sample[19].f = control_feed_scale_candidate;
    /* Trace reason is u16 and mode flags are u8 in the firmware reply. */
    sample[20].u = (uint32_t)trace_reason |
                   ((uint32_t)trace_mode_flags << 16);
    if (hal_stream_write(&dthc_voltage_stream, sample) < 0)
        logging_stream_overruns++;
}

/* CMD_DATA reply payload layout:
 *   [0..1]   tipvolts     (u16, Q4)
 *   [2..3]   current      (u16, Q4)
 *   [4..7]   status_code  (u32)
 *   [8..11]  step_delta   (s32)
 *   [12..13] target_volts (u16, Q4)
 *   Legacy: [14] count, [15..] packed samples.
 *   V2: [14] 0x82, [15..18] first 100-us tick, [19] count,
 *       [20..] packed samples.
 *   V3: [14] 0x83, [15..18] first tick, [19] count (at most 12),
 *       [20..] packed samples with THC enable in bit 13.
 */
static void dthc_parse_data_reply(struct __comp_state *__comp_inst,
                                  const uint8_t *payload, uint8_t payload_len)
{
    int i, count;
    uint16_t tip_raw, current_raw;

    if (payload_len < 14) {
        comm_bad_length++;
        comm_bad_frames++;
        return;
    }

    tip_raw = dthc_get_u16(payload + 0);
    current_raw = dthc_get_u16(payload + 2);
    data_tip_volts   = tip_raw / 16;
    data_current     = current_raw / 16;
    data_tip_volts_precise = (double)tip_raw / 16.0;
    data_current_precise = (double)current_raw / 16.0;
    data_step_delta  = (int32_t)dthc_get_u32(payload + 8);
    data_target_volts= dthc_get_u16(payload + 12) / 16;
    dthc_apply_status(__comp_inst, dthc_get_u32(payload + 4));

    if ((payload_len >= 20) && (payload[14] == 0x83u)) {
        uint32_t first_tick = dthc_get_u32(payload + 15);
        count = payload[19];
        if (count > 12 || (int)(payload_len - 20) < count * 2) {
            comm_bad_length++;
            comm_bad_frames++;
            return;
        }
        for (i = 0; i < count; i++)
            dthc_stream_voltage_sample(__comp_inst, first_tick + (uint32_t)i,
                dthc_get_u16(payload + 20 + (i * 2)), 1u);
    } else if ((payload_len >= 20) && (payload[14] == 0x82u)) {
        uint32_t first_tick = dthc_get_u32(payload + 15);
        count = payload[19];
        if (count > 12) count = 12;
        if ((int)(payload_len - 20) < count * 2)
            count = (payload_len - 20) / 2;
        for (i = 0; i < count; i++)
            dthc_stream_voltage_sample(__comp_inst, first_tick + (uint32_t)i,
                dthc_get_u16(payload + 20 + (i * 2)), 0u);
    } else if (payload_len >= 15) {
        count = payload[14];
        if (count > 14) count = 14;
        if ((int)(payload_len - 15) < count * 2)
            count = (payload_len - 15) / 2;
        for (i = 0; i < count; i++)
            dthc_stream_voltage_sample(__comp_inst, 0u,
                dthc_get_u16(payload + 15 + (i * 2)), 0u);
    }
}

/* CMD_CONFIG reply payload layout (42 bytes when DTHC6 FW_REV is present):
 *   [0]      deadband          (u8)
 *   [1..2]   delay             (u16, ms)
 *   [3..4]   set_point         (u16, Q4)
 *   [5..6]   upper_limit       (u16, Q4)
 *   [7..8]   lower_limit       (u16, Q4)
 *   [9..10]  arcok_current     (u16, Q4)
 *   [11..12] minvel            (u16)
 *   [13..14] Pgain             (s16)
 *   [15..16] Igain             (s16)
 *   [17..18] Dgain             (s16)
 *   [19..22] steps_per_unit    (u32)
 *   [23..26] max_up_velocity   (u32)
 *   [27..30] acceleration      (u32)
 *   [31]     dir_up_polarity   (u8)
 *   [32]     step_polarity     (u8)
 *   [33]     unit_type         (u8)
 *   [34..37] max_down_velocity (u32)
 *   [38..41] FW_REV            (u32, optional on older firmware)
 */
static void dthc_parse_config_reply(struct __comp_state *__comp_inst,
                                    const uint8_t *payload, uint8_t payload_len)
{
    if (payload_len < 38) {
        comm_bad_length++;
        comm_bad_frames++;
        return;
    }

    fb_thc_deadband      = (double)payload[0]                / 16.0;
    fb_thc_delay         = (double)dthc_get_u16(payload + 1) / 1000.0;
    fb_thc_set_point     = dthc_get_u16(payload + 3) / 16;
    fb_thc_upper_limit   = dthc_get_u16(payload + 5) / 16;
    fb_thc_lower_limit   = dthc_get_u16(payload + 7) / 16;
    fb_thc_arcok_current = dthc_get_u16(payload + 9) / 16;
    fb_thc_minvel        = dthc_get_u16(payload + 11);
    fb_thc_pgain         = dthc_get_u16(payload + 13);
    fb_thc_igain         = dthc_get_u16(payload + 15);
    fb_thc_dgain         = dthc_get_u16(payload + 17);

    /* Echo writable cfg pins back from firmware so the GUI sees the
     * initial values on startup (mirrors c3_main HAL_IO pin behaviour). */
    cfg_thc_set_point = fb_thc_set_point;
    cfg_thc_delay     = fb_thc_delay;

    fb_motor_steps_per_unit   = dthc_get_u32(payload + 19);
    fb_motor_max_up_velocity  = dthc_get_u32(payload + 23);
    fb_motor_acceleration     = dthc_get_u32(payload + 27);
    fb_motor_dir_up_polarity  = payload[31] ? 1 : 0;
    fb_motor_step_polarity    = payload[32] ? 1 : 0;
    fb_motor_metric_units     = payload[33] ? 1 : 0;
    fb_motor_max_down_velocity= dthc_get_u32(payload + 34);
    if (payload_len >= 42)
        fw_app_rev = dthc_get_u32(payload + 38);
    if (payload_len >= 43)
        fb_thc_response_trim = (int8_t)payload[42];
    if ((fw_app_rev >= DTHC_PROFILE_FW_REV) && !profile_request_started) {
        profile_action = DTHC_PROFILE_READ;
        profile_page = 0u;
        profile_waiting = 0u;
        profile_request_started = 1u;
    }

    /* Match the DTHCIV/5 startup behavior: the configuration readback
     * reflects what is currently stored in the DTHC, while cfg.motor.*
     * contains the INI-backed settings that CommandCNC wants.  Send the
     * complete motor configuration only when at least one field differs,
     * then request another config reply to verify it (handled by write()). */
    if ((fb_motor_steps_per_unit    != cfg_motor_steps_per_unit) ||
        (fb_motor_max_up_velocity   != cfg_motor_max_up_velocity) ||
        (fb_motor_max_down_velocity != cfg_motor_max_down_velocity) ||
        (fb_motor_acceleration      != cfg_motor_acceleration) ||
        (fb_motor_dir_up_polarity   != (cfg_motor_dir_up_polarity ? 1 : 0)) ||
        (fb_motor_step_polarity     != (cfg_motor_step_polarity ? 1 : 0)) ||
        (fb_motor_metric_units      != (cfg_motor_metric_units ? 1 : 0))) {
        pending_motor_config_write = 1;
    }

    comm_config_valid = 1;
}

static void dthc_parse_autosettings_reply(struct __comp_state *__comp_inst,
                                          const uint8_t *payload,
                                          uint8_t payload_len)
{
    if (payload_len < 4) {
        comm_bad_length++;
        comm_bad_frames++;
        return;
    }
    fb_autoset_upper_tol = (double)payload[0]                / 16.0;
    fb_autoset_lower_tol = (double)payload[1]                / 16.0;
    fb_autoset_delay     = (double)dthc_get_u16(payload + 2) / 1000.0;
    comm_autosettings_valid = 1;

    /* Echo writable cfg pins back from firmware so the GUI sees the
     * confirmed values on startup. */
    cfg_autoset_upper_tol = fb_autoset_upper_tol;
    cfg_autoset_lower_tol = fb_autoset_lower_tol;
}

/* Firmware 2.3 appends the Auto fields (profile version 4). */
static uint32_t dthc_profile_length(struct __comp_state *__comp_inst)
{
    return (fw_app_rev >= DTHC_AUTO_FW_REV) ? DTHC_PROFILE_V4_BYTES :
                                              DTHC_PROFILE_V3_BYTES;
}

static void dthc_profile_to_pins(struct __comp_state *__comp_inst)
{
    cfg_control_qualification_flags = dthc_get_u16(profile_bytes + 4);
    cfg_control_observer_mode = profile_bytes[6];
    cfg_control_target_mode = profile_bytes[7];
    cfg_control_slowdown_mode = profile_bytes[8];
    cfg_control_feedforward_cap = (double)profile_bytes[9] / 255.0;
    cfg_control_deadzone_min = (double)dthc_get_u16(profile_bytes + 10) / 16.0;
    cfg_control_deadzone_max = (double)dthc_get_u16(profile_bytes + 12) / 16.0;
    cfg_control_kquiet_per_s = (double)dthc_get_u32(profile_bytes + 14) / 65536.0;
    cfg_control_e_nominal_up_mm = (double)dthc_get_u32(profile_bytes + 18) / 1000000.0;
    cfg_control_e_high_up_mm = (double)dthc_get_u32(profile_bytes + 22) / 1000000.0;
    cfg_control_e_nominal_down_mm = (double)dthc_get_u32(profile_bytes + 26) / 1000000.0;
    cfg_control_e_high_down_mm = (double)dthc_get_u32(profile_bytes + 30) / 1000000.0;
    cfg_control_observer_alpha = (double)dthc_get_u16(profile_bytes + 34) / 65536.0;
    cfg_control_observer_beta = (double)dthc_get_u16(profile_bytes + 36) / 65536.0;
    cfg_control_residual_clip_mm = (double)dthc_get_u32(profile_bytes + 38) / 1000000.0;
    cfg_control_observer_decay = (double)dthc_get_u16(profile_bytes + 42) / 65536.0;
    cfg_control_confidence_rise = profile_bytes[44];
    cfg_control_confidence_fall = profile_bytes[45];
    cfg_control_confidence_min_apply = (double)profile_bytes[46] / 255.0;
    cfg_control_conf_evidence_ms = profile_bytes[47];
    cfg_control_vad_down_min = (double)profile_bytes[48] / 255.0;
    cfg_control_vad_lock = (double)profile_bytes[49] / 255.0;
    cfg_control_vad_unlock = (double)profile_bytes[50] / 255.0;
    cfg_control_target_k = (double)dthc_get_u16(profile_bytes + 52) / 65536.0;
    cfg_control_target_max_offset =
        (double)dthc_get_u16(profile_bytes + 54) / 16.0;
    cfg_control_target_filter = (double)dthc_get_u16(profile_bytes + 56) / 65536.0;
    cfg_control_target_slew_volts_s =
        (double)dthc_get_u16(profile_bytes + 58) / 16.0;
    cfg_control_slowdown_min_scale = (double)profile_bytes[60] / 255.0;
    cfg_control_slowdown_z_margin = (double)profile_bytes[61] / 255.0;
    cfg_control_slowdown_attack = (double)profile_bytes[62] / 255.0;
    cfg_control_slowdown_release = (double)profile_bytes[63] / 255.0;
    cfg_control_slowdown_min_conf = (double)profile_bytes[64] / 255.0;
    cfg_control_slowdown_delay_ms = dthc_get_u16(profile_bytes + 66);
    cfg_control_slowdown_min_on_ms = dthc_get_u16(profile_bytes + 68);
    cfg_control_slowdown_timeout_ms = dthc_get_u16(profile_bytes + 70);
    if (DTHC_PROFILE_BYTES >= DTHC_PROFILE_V4_BYTES) {
        cfg_control_loop_delay_ms = profile_bytes[72];
        cfg_control_brake_accel_fraction = (double)profile_bytes[73] / 256.0;
        cfg_control_auto_flags = profile_bytes[74];
        cfg_control_kerf_threshold =
            (double)dthc_get_u16(profile_bytes + 75) / 16.0;
        cfg_control_kerf_hold_max_ms = dthc_get_u16(profile_bytes + 77);
        cfg_control_transition_error_mm =
            (double)dthc_get_u16(profile_bytes + 79) / 1000.0;
    }
    fb_profile_generation = dthc_get_u32(profile_bytes + 0);
    fb_profile_length = DTHC_PROFILE_BYTES;
    fb_profile_valid = 1;
    fb_profile_read_sequence++;
}

static void dthc_pins_to_profile(struct __comp_state *__comp_inst)
{
    unsigned mode;
    dthc_put_u16(profile_bytes + 4,
        (uint16_t)(cfg_control_qualification_flags & 0xffffu));
    mode = cfg_control_observer_mode;
    if (mode > ((fw_app_rev >= DTHC_AUTO_FW_REV) ? 3u : 2u))
        mode = 0u;
    profile_bytes[6] = (uint8_t)mode;
    mode = cfg_control_target_mode;
    profile_bytes[7] = (mode > 2u) ? 1u : (uint8_t)mode;
    mode = cfg_control_slowdown_mode;
    profile_bytes[8] = (mode > 2u) ? 1u : (uint8_t)mode;
    profile_bytes[9] = dthc_encode_fraction_q8(cfg_control_feedforward_cap);
    dthc_put_u16(profile_bytes + 10, dthc_encode_q4(cfg_control_deadzone_min));
    dthc_put_u16(profile_bytes + 12, dthc_encode_q4(cfg_control_deadzone_max));
    dthc_put_u32(profile_bytes + 14,
        dthc_encode_uq16(cfg_control_kquiet_per_s));
    dthc_put_u32(profile_bytes + 18,
        dthc_encode_u32(cfg_control_e_nominal_up_mm * 1000000.0));
    dthc_put_u32(profile_bytes + 22,
        dthc_encode_u32(cfg_control_e_high_up_mm * 1000000.0));
    dthc_put_u32(profile_bytes + 26,
        dthc_encode_u32(cfg_control_e_nominal_down_mm * 1000000.0));
    dthc_put_u32(profile_bytes + 30,
        dthc_encode_u32(cfg_control_e_high_down_mm * 1000000.0));
    dthc_put_u16(profile_bytes + 34,
        dthc_encode_u16(cfg_control_observer_alpha * 65536.0));
    dthc_put_u16(profile_bytes + 36,
        dthc_encode_u16(cfg_control_observer_beta * 65536.0));
    dthc_put_u32(profile_bytes + 38,
        dthc_encode_u32(cfg_control_residual_clip_mm * 1000000.0));
    dthc_put_u16(profile_bytes + 42,
        dthc_encode_u16(cfg_control_observer_decay * 65536.0));
    profile_bytes[44] = dthc_clamp_u8(cfg_control_confidence_rise);
    profile_bytes[45] = dthc_clamp_u8(cfg_control_confidence_fall);
    profile_bytes[46] = dthc_encode_fraction_q8(cfg_control_confidence_min_apply);
    profile_bytes[47] = dthc_clamp_u8(cfg_control_conf_evidence_ms);
    profile_bytes[48] = dthc_encode_fraction_q8(cfg_control_vad_down_min);
    profile_bytes[49] = dthc_encode_fraction_q8(cfg_control_vad_lock);
    profile_bytes[50] = dthc_encode_fraction_q8(cfg_control_vad_unlock);
    dthc_put_u16(profile_bytes + 52,
        dthc_encode_u16(cfg_control_target_k * 65536.0));
    dthc_put_u16(profile_bytes + 54,
        dthc_encode_q4(cfg_control_target_max_offset));
    dthc_put_u16(profile_bytes + 56,
        dthc_encode_u16(cfg_control_target_filter * 65536.0));
    dthc_put_u16(profile_bytes + 58,
        dthc_encode_q4(cfg_control_target_slew_volts_s));
    profile_bytes[60] = dthc_encode_fraction_q8(cfg_control_slowdown_min_scale);
    profile_bytes[61] = dthc_encode_fraction_q8(cfg_control_slowdown_z_margin);
    profile_bytes[62] = dthc_encode_fraction_q8(cfg_control_slowdown_attack);
    profile_bytes[63] = dthc_encode_fraction_q8(cfg_control_slowdown_release);
    profile_bytes[64] = dthc_encode_fraction_q8(cfg_control_slowdown_min_conf);
    dthc_put_u16(profile_bytes + 66,
        dthc_encode_u16(cfg_control_slowdown_delay_ms));
    dthc_put_u16(profile_bytes + 68,
        dthc_encode_u16(cfg_control_slowdown_min_on_ms));
    dthc_put_u16(profile_bytes + 70,
        dthc_encode_u16(cfg_control_slowdown_timeout_ms));
    if (DTHC_PROFILE_BYTES >= DTHC_PROFILE_V4_BYTES) {
        double brake = cfg_control_brake_accel_fraction * 256.0 + 0.5;
        profile_bytes[72] = dthc_clamp_u8(cfg_control_loop_delay_ms);
        profile_bytes[73] = (brake < 1.0) ? 1u :
                            (brake > 255.0) ? 255u : (uint8_t)brake;
        profile_bytes[74] = dthc_clamp_u8(cfg_control_auto_flags);
        dthc_put_u16(profile_bytes + 75,
            dthc_encode_q4(cfg_control_kerf_threshold));
        dthc_put_u16(profile_bytes + 77,
            dthc_encode_u16(cfg_control_kerf_hold_max_ms));
        dthc_put_u16(profile_bytes + 79,
            dthc_encode_u16(cfg_control_transition_error_mm * 1000.0));
    }
}

static void dthc_parse_profile_reply(struct __comp_state *__comp_inst,
                                     const uint8_t *payload,
                                     uint8_t payload_len)
{
    uint8_t status, op, page, count;
    uint16_t total;
    if (payload_len < 14u) {
        comm_bad_length++;
        comm_bad_frames++;
        return;
    }
    status = payload[0];
    op = payload[1];
    page = payload[2];
    total = dthc_get_u16(payload + 3);
    if (profile_action == DTHC_PROFILE_NONE)
        return; /* Ignore a late reply from an aborted write. */
    fb_profile_last_status = status;
    fb_profile_generation = dthc_get_u32(payload + 5);
    fb_profile_crc = dthc_get_u32(payload + 9);
    fb_profile_length = total;
    count = payload[13];

    if ((total != DTHC_PROFILE_BYTES) || status != 0u) {
        fb_profile_valid = 0;
        profile_action = DTHC_PROFILE_NONE;
        profile_waiting = 0u;
        return;
    }

    if ((op == 0u) && (profile_action == DTHC_PROFILE_READ) &&
        (page == profile_page)) {
        uint32_t offset = (uint32_t)page * DTHC_PROFILE_PAGE_BYTES;
        uint32_t expected = DTHC_PROFILE_BYTES - offset;
        uint32_t i;
        if (expected > DTHC_PROFILE_PAGE_BYTES) expected = DTHC_PROFILE_PAGE_BYTES;
        if ((count != expected) || (payload_len < (uint8_t)(14u + count))) {
            fb_profile_valid = 0;
            profile_action = DTHC_PROFILE_NONE;
            profile_waiting = 0u;
            return;
        }
        for (i = 0; i < count; ++i)
            profile_bytes[offset + i] = payload[14u + i];
        profile_waiting = 0u;
        profile_page++;
        if (profile_page >= DTHC_PROFILE_PAGE_COUNT) {
            uint32_t readback_crc = dthc_crc32(
                profile_bytes, DTHC_PROFILE_BYTES);
            if ((readback_crc != fb_profile_crc) ||
                (dthc_get_u32(profile_bytes) != fb_profile_generation)) {
                fb_profile_valid = 0;
                fb_profile_last_status = 4u;
            } else {
                fb_profile_crc = readback_crc;
                dthc_profile_to_pins(__comp_inst);
            }
            profile_action = DTHC_PROFILE_NONE;
        }
    } else if ((op == 1u) && (profile_action == DTHC_PROFILE_WRITE) &&
               (page == profile_page)) {
        profile_waiting = 0u;
        profile_page++;
        if (profile_page >= DTHC_PROFILE_PAGE_COUNT)
            profile_action = DTHC_PROFILE_COMMIT;
    } else if ((op == 2u) && (profile_action == DTHC_PROFILE_COMMIT)) {
        profile_waiting = 0u;
        profile_action = DTHC_PROFILE_READ;
        profile_page = 0u;
    }
}

static void dthc_parse_trace_reply(struct __comp_state *__comp_inst,
                                   const uint8_t *payload,
                                   uint8_t payload_len)
{
    if ((payload_len < 41u) || (payload[0] < 2u) || (payload[0] > 3u) ||
        ((payload[0] == 3u) && (payload_len < 44u))) {
        comm_bad_length++;
        comm_bad_frames++;
        return;
    }
    trace_mode_flags = payload[1];
    trace_reason = dthc_get_u16(payload + 2);
    trace_base_target = (double)dthc_get_u16(payload + 8) / 16.0;
    trace_adjusted_target = (double)dthc_get_u16(payload + 10) / 16.0;
    trace_target_candidate = (double)dthc_get_u16(payload + 12) / 16.0;
    trace_control_volts = (double)dthc_get_u16(payload + 14) / 16.0;
    trace_confidence = (double)payload[16] / 255.0;
    trace_load = (double)payload[17] / 255.0;
    trace_rxy = (double)payload[18] / 255.0;
    control_feed_scale_candidate = (double)payload[19] / 255.0;
    trace_g_hat_mm = (double)dthc_get_s24(payload + 20) / 1000.0;
    trace_w_hat_mm_s = (double)dthc_get_s24(payload + 23) / 1000.0;
    trace_residual_mm = (double)dthc_get_s24(payload + 26) / 1000.0;
    trace_feedback_mm_s = (double)dthc_get_s24(payload + 29) / 1000.0;
    trace_feedforward_mm_s = (double)dthc_get_s24(payload + 32) / 1000.0;
    trace_request_mm_s = (double)dthc_get_s24(payload + 35) / 1000.0;
    trace_realized_mm_s = (double)dthc_get_s24(payload + 38) / 1000.0;
    trace_kerf_hold = (trace_reason & 0x0100u) ? 1 : 0;
    {
        double xy_mm_s = logging_xy_velocity_realtime *
                         (cfg_motor_metric_units ? 1.0 : 25.4);
        trace_slope = (xy_mm_s > 0.1) ? trace_w_hat_mm_s / xy_mm_s : 0.0;
    }
    if (payload[0] >= 3u) {
        uint32_t value = dthc_get_u16(payload + 42);
        switch (payload[41]) {
        case 0: trace_compute_max_us = value; break;
        case 1: trace_late_discards = value; break;
        case 2: trace_late_overwrites = value; break;
        case 3: trace_kerf_holds = value; break;
        case 4: trace_bandwidth = value; break;
        case 5: trace_loop_delay_ms = value; break;
        case 6: break; /* response trim; fb.thc.response-trim has it */
        case 7: trace_noise_mm = (double)value / 1000.0; break;
        case 8: trace_delay_estimate = (double)value / 10.0; break;
        case 9: trace_arc_gain = (double)value / 256.0; break;
        case 10: trace_ident_fits = value; break;
        case 11: trace_spi_repairs = value; break;
        case 12: trace_spi_tx_underflows = value; break;
        case 13: trace_spi_rx_overflows = value; break;
        case 14: trace_spi_timeout_resets = value; break;
        case 15: trace_spi_late_frames = value; break;
        case 16: trace_stack_peak = value; break;
        case 17: trace_last_event = value; break;
        case 18: trace_last_event_context = value; break;
        case 19: trace_last_event_pc = (trace_last_event_pc & 0xffff0000u) | value; break;
        case 20: trace_last_event_pc = (trace_last_event_pc & 0x0000ffffu) | (value << 16); break;
        case 21: trace_last_event_lr = (trace_last_event_lr & 0xffff0000u) | value; break;
        case 22: trace_last_event_lr = (trace_last_event_lr & 0x0000ffffu) | (value << 16); break;
        case 23: trace_event_count = value; break;
        case 24: trace_load_fw_rejects = value; break;
        case 25: trace_isr_max_motor_us = (double)value / 10.0; break;
        case 26: trace_isr_max_gpio_us = (double)value / 10.0; break;
        case 27: trace_isr_max_spi_us = (double)value / 10.0; break;
        case 28: trace_isr_max_systick_us = (double)value / 10.0; break;
        case 29: trace_mask_max_us = (double)value / 10.0; break;
        default: break;
        }
    }
    /* Publish tick after the rest of the snapshot for userspace recorders. */
    trace_tick = dthc_get_u32(payload + 4);
    trace_age_cycles = 0u;
}

/* ================================================================
 * Payload builders
 * ================================================================ */

/* CMD_DATA request: legacy bytes remain first, followed by the revision-2
 * validity flags, commanded/actual scalar XY velocity in units/min Q16.16,
 * and a monotonically increasing host sample sequence.
 *   bit 0 : motor_up
 *   bit 1 : thc_enable   (unused when use_enable_pin=1)
 *   bit 2 : reset_step_delta
 *   bit 3 : torch_off
 *   bit 4 : enable_autoset
 *   bit 5 : do_autoset
 *   bit 6 : use_enable_pin
 *   bit 7 : motor_down
 *   byte 1: response scale, 0..255 (255 = established full response)
 */
static uint8_t dthc_build_data_payload(struct __comp_state *__comp_inst,
                                       uint8_t *payload)
{
    uint8_t flags = 0;
    unsigned motor_up_cmd = cmd_motor_up ? 1u : 0u;
    unsigned motor_down_cmd = cmd_motor_down ? 1u : 0u;
    unsigned motor_test_allowed =
        comm_online && cmd_machine_is_on && thc_prog_is_idle &&
        !status_torch_on && !update_enable &&
        (update_state == DTHC_UPDATE_RUN);

    /* Any inhibit or conflicting command disarms the test until both
     * momentary inputs have been observed released.  This prevents a held
     * GUI/HAL input from restarting motion as an interlock recovers. */
    if (!motor_test_allowed || (motor_up_cmd && motor_down_cmd)) {
        motor_test_armed = 0;
    } else if (!motor_up_cmd && !motor_down_cmd) {
        motor_test_armed = 1;
    }

    if (motor_test_allowed && motor_test_armed) {
        if (motor_up_cmd)
            flags |= 0x01u;
        else if (motor_down_cmd)
            flags |= 0x80u;
    }

    /* bit 1 (thc_enable) left 0: cmd.use-enable-pin defers control to hw */
    if (pending_reset_step_delta) flags |= 0x04u;
    if (cmd_torch_off)            flags |= 0x08u;
    if (cmd_enable_autoset)       flags |= 0x10u;
    if (pending_do_autoset)       flags |= 0x20u;
    if (cmd_use_enable_pin)       flags |= 0x40u;

    payload[0] = flags;

    /* Basic velocity-adaptive response: at full programmed XY velocity the
     * established DTHC response is unchanged; during commanded slowdowns the
     * firmware receives a proportionally softer response.  The existing
     * thcenable path remains the hard VAD backstop.  Missing/invalid velocity
     * nets fail to 255 so old generated configurations are unaffected. */
    payload[1] = 255u;
    if (thc_vad_enabled && !thc_prog_is_idle &&
        (logging_xy_velocity_commanded > 0.000001) &&
        (logging_xy_velocity_realtime >= 0.0)) {
        /* Our own point-10 slowdown is not a corner: compare against the
         * commanded speed it asked LinuxCNC for. */
        double expected = logging_xy_velocity_commanded;
        if ((control_feed_scale_applied > 0.0) &&
            (control_feed_scale_applied < 1.0))
            expected *= control_feed_scale_applied;
        double ratio = logging_xy_velocity_realtime / expected;

        if (ratio <= 0.0)
            payload[1] = 0u;
        else if (ratio < 1.0)
            payload[1] = (uint8_t)(ratio * 255.0 + 0.5);
    }

    pending_reset_step_delta = 0;
    pending_do_autoset = 0;

    if (fw_app_rev >= DTHC_OBSERVER_FW_REV) {
        uint8_t runtime_flags = 0u;
        if ((logging_xy_velocity_commanded >= 0.0) &&
            (logging_xy_velocity_realtime >= 0.0))
            runtime_flags |= 0x01u;
        if (logging_enable && fw_app_rev >= DTHC_VOLTAGE_HISTORY_FW_REV)
            runtime_flags |= 0x0Eu; /* tick-anchored history with sampled THC enable */
        payload[2] = runtime_flags;
        dthc_put_u32(payload + 3,
            dthc_encode_uq16(logging_xy_velocity_commanded * 60.0));
        dthc_put_u32(payload + 7,
            dthc_encode_uq16(logging_xy_velocity_realtime * 60.0));
        dthc_put_u32(payload + 11, ++host_sample_sequence);
        return 15;
    }
    return 2;
}

static uint8_t dthc_build_profile_payload(struct __comp_state *__comp_inst,
                                          uint8_t *payload)
{
    uint32_t offset, count, i;
    if (profile_action == DTHC_PROFILE_READ) {
        payload[0] = 0u;
        payload[1] = (uint8_t)profile_page;
        return 2u;
    }
    if (profile_action == DTHC_PROFILE_WRITE) {
        offset = profile_page * DTHC_PROFILE_PAGE_BYTES;
        count = DTHC_PROFILE_BYTES - offset;
        if (count > DTHC_PROFILE_PAGE_BYTES) count = DTHC_PROFILE_PAGE_BYTES;
        payload[0] = 1u;
        payload[1] = (uint8_t)profile_page;
        payload[2] = (uint8_t)count;
        for (i = 0u; i < count; ++i)
            payload[3u + i] = profile_bytes[offset + i];
        return (uint8_t)(3u + count);
    }
    payload[0] = 2u;
    dthc_put_u32(payload + 1, dthc_crc32(profile_bytes, DTHC_PROFILE_BYTES));
    return 5u;
}

/* CMD_CONF_SET mode 0 (THC parameters), 20 bytes:
 *   [0]      mode = 0
 *   [1]      deadband    (u8)
 *   [2..3]   delay       (u16, ms) - uses auto-delay if thc.autodelay
 *   [4..5]   set_point   (u16, Q4)
 *   [6..7]   upper_limit (u16, Q4)
 *   [8..9]   lower_limit (u16, Q4)
 *   [10..11] arcok_current (u16, Q4)
 *   [12..13] minvel      (u16)
 *   [14..15] Pgain       (s16)
 *   [16..17] Igain       (s16)
 *   [18..19] Dgain       (s16)
 *   [20]     Auto response trim (s8: -1, 0, 1), firmware 2.3 and later
 */
static uint8_t dthc_build_thc_config_payload(struct __comp_state *__comp_inst,
                                             uint8_t *payload)
{
    double delay_val = (thc_autodelay && thc_auto_delay > 0.0)
                       ? thc_auto_delay : cfg_thc_delay;

    payload[0] = 0;
    payload[1] = dthc_clamp_u8(dthc_encode_q4(cfg_thc_deadband));
    dthc_put_u16(payload + 2,  dthc_encode_ms(delay_val));
    dthc_put_u16(payload + 4,  dthc_encode_q4((double)cfg_thc_set_point));
    dthc_put_u16(payload + 6,  dthc_encode_q4((double)cfg_thc_upper_limit));
    dthc_put_u16(payload + 8,  dthc_encode_q4((double)cfg_thc_lower_limit));
    dthc_put_u16(payload + 10, dthc_encode_q4((double)cfg_thc_arcok_current));
    dthc_put_u16(payload + 12, dthc_encode_u16((double)cfg_thc_minvel));
    dthc_put_u16(payload + 14, dthc_encode_u16((double)cfg_thc_pgain));
    dthc_put_u16(payload + 16, dthc_encode_u16((double)cfg_thc_igain));
    dthc_put_u16(payload + 18, dthc_encode_u16((double)cfg_thc_dgain));
    if (fw_app_rev >= DTHC_AUTO_FW_REV) {
        int trim = cfg_thc_response_trim;
        payload[20] = (uint8_t)(int8_t)((trim < -1) ? -1 : (trim > 1) ? 1 : trim);
        return 21;
    }
    return 20;
}

/* CMD_CONF_SET mode 1 (motor parameters), 20 bytes:
 *   [0]      mode = 1
 *   [1..4]   steps_per_unit    (u32)
 *   [5..8]   max_up_velocity   (u32)
 *   [9..12]  acceleration      (u32)
 *   [13]     dir_up_polarity   (u8)
 *   [14]     step_polarity     (u8)
 *   [15]     unit_type         (u8)
 *   [16..19] max_down_velocity (u32)
 */
static uint8_t dthc_build_motor_config_payload(struct __comp_state *__comp_inst,
                                               uint8_t *payload)
{
    payload[0] = 1;
    dthc_put_u32(payload + 1,  cfg_motor_steps_per_unit);
    dthc_put_u32(payload + 5,  cfg_motor_max_up_velocity);
    dthc_put_u32(payload + 9,  cfg_motor_acceleration);
    payload[13] = cfg_motor_dir_up_polarity ? 1 : 0;
    payload[14] = cfg_motor_step_polarity   ? 1 : 0;
    payload[15] = cfg_motor_metric_units    ? 1 : 0;
    dthc_put_u32(payload + 16, cfg_motor_max_down_velocity);
    return 20;
}

/* CMD_AUTOSETTINGS payload, 4 bytes */
static uint8_t dthc_build_autosettings_payload(struct __comp_state *__comp_inst,
                                               uint8_t *payload)
{
    double delay_val = (thc_auto_delay > 0.0) ? thc_auto_delay : cfg_autoset_delay;

    payload[0] = dthc_clamp_u8(dthc_encode_q4(cfg_autoset_upper_tol));
    payload[1] = dthc_clamp_u8(dthc_encode_q4(cfg_autoset_lower_tol));
    dthc_put_u16(payload + 2, dthc_encode_ms(delay_val));
    return 4;
}

static void dthc_queue_frame(struct __comp_state *__comp_inst, uint8_t cmd,
                             const uint8_t *payload, uint8_t payload_len)
{
    dthc_build_frame(tx_frame, cmd, payload, payload_len);
    dthc_frame_to_tram(__comp_inst, tx_frame);
    comm_last_tx_cmd = cmd;
}

/* ================================================================
 * Firmware update bridge
 * ================================================================ */
static dthc_bspi_bridge_shm_t *dthc_bridge_shm(struct __comp_state *__comp_inst)
{
    (void)__comp_inst;
    return (dthc_bspi_bridge_shm_t *)bridge_shmem_ptr;
}

static void dthc_bridge_copy_to_volatile(volatile uint8_t *dst,
                                         const uint8_t *src)
{
    int i;
    for (i = 0; i < DTHC_SPI_PACKET_SIZE; i++)
        dst[i] = src[i];
}

static void dthc_bridge_copy_from_volatile(uint8_t *dst,
                                           const volatile uint8_t *src)
{
    int i;
    for (i = 0; i < DTHC_SPI_PACKET_SIZE; i++)
        dst[i] = src[i];
}

static int dthc_frame_has_nonzero_byte(const uint8_t *frame)
{
    int i;
    for (i = 0; i < DTHC_SPI_PACKET_SIZE; i++) {
        if (frame[i] != 0)
            return 1;
    }
    return 0;
}

static void dthc_bridge_publish(struct __comp_state *__comp_inst)
{
    dthc_bspi_bridge_shm_t *shm = dthc_bridge_shm(__comp_inst);

    update_active = (update_state != DTHC_UPDATE_RUN) ? 1 : 0;
    update_bridge_ready = (update_state == DTHC_UPDATE_BRIDGE_READY) ? 1 : 0;

    if (shm) {
        shm->bridge_state = update_state;
        shm->bridge_error = update_error_code;
    }
}

static void dthc_bridge_zero_tram(struct __comp_state *__comp_inst)
{
    int i;
    for (i = 0; i < DTHC_SPI_PACKET_SIZE; i++)
        tx_frame[i] = 0;
    dthc_frame_to_tram(__comp_inst, tx_frame);
    comm_last_tx_cmd = 0;
}

static void dthc_bridge_reset_exchange(struct __comp_state *__comp_inst)
{
    dthc_bspi_bridge_shm_t *shm = dthc_bridge_shm(__comp_inst);
    int i;

    bridge_inflight = 0;
    bridge_discard_next_read = 0;
    bridge_inflight_seq = 0;

    if (!shm)
        return;

    shm->response_seq = shm->request_seq;
    shm->response_status = 0;
    for (i = 0; i < DTHC_SPI_PACKET_SIZE; i++) {
        shm->request_frame[i] = 0;
        shm->response_frame[i] = 0;
    }
}

static void dthc_bridge_fault(struct __comp_state *__comp_inst, int error_code)
{
    update_state = DTHC_UPDATE_FAULT;
    update_error_code = error_code;
    bridge_inflight = 0;
    bridge_discard_next_read = 0;
    dthc_bridge_zero_tram(__comp_inst);
    dthc_bridge_publish(__comp_inst);
}

static void dthc_bridge_enter(struct __comp_state *__comp_inst)
{
    dthc_bspi_bridge_shm_t *shm = dthc_bridge_shm(__comp_inst);

    update_state = DTHC_UPDATE_QUIESCING;
    update_error_code = DTHC_UPDATE_ERR_NONE;
    dthc_bridge_publish(__comp_inst);

    if (!shm) {
        dthc_bridge_fault(__comp_inst, DTHC_UPDATE_ERR_SHMEM);
        return;
    }

    if (hm2_bspi_clear_fifo(bspi_chan) < 0) {
        dthc_bridge_fault(__comp_inst, DTHC_UPDATE_ERR_FIFO_CLEAR);
        return;
    }

    dthc_bridge_reset_exchange(__comp_inst);
    dthc_bridge_zero_tram(__comp_inst);

    update_state = DTHC_UPDATE_BRIDGE_READY;
    dthc_bridge_publish(__comp_inst);
}

static void dthc_bridge_restore(struct __comp_state *__comp_inst)
{
    update_state = DTHC_UPDATE_RESTORING;
    update_bridge_ready = 0;
    dthc_bridge_publish(__comp_inst);

    if (bridge_inflight)
        update_error_code = DTHC_UPDATE_ERR_ABORTED;

    bridge_inflight = 0;
    bridge_discard_next_read = 0;

    if (hm2_bspi_clear_fifo(bspi_chan) < 0)
        update_error_code = DTHC_UPDATE_ERR_FIFO_CLEAR;

    dthc_build_frame(tx_frame, 0, 0, 0);
    dthc_frame_to_tram(__comp_inst, tx_frame);
    pending_config_read = 1;
    pending_autosettings_write = 1;

    if (update_error_code == DTHC_UPDATE_ERR_FIFO_CLEAR) {
        update_state = DTHC_UPDATE_FAULT;
    } else {
        update_state = DTHC_UPDATE_RUN;
        update_active = 0;
        update_bridge_ready = 0;
    }
    dthc_bridge_publish(__comp_inst);
}

static int dthc_bridge_write(struct __comp_state *__comp_inst)
{
    dthc_bspi_bridge_shm_t *shm = dthc_bridge_shm(__comp_inst);
    uint32_t req_seq, resp_seq;

    if (!update_enable) {
        dthc_bridge_restore(__comp_inst);
        return 0;
    }

    if (update_state == DTHC_UPDATE_RUN)
        dthc_bridge_enter(__comp_inst);

    if (update_state == DTHC_UPDATE_FAULT) {
        dthc_bridge_zero_tram(__comp_inst);
        return 0;
    }

    if (!shm) {
        dthc_bridge_fault(__comp_inst, DTHC_UPDATE_ERR_SHMEM);
        return 0;
    }

    req_seq = shm->request_seq;
    resp_seq = shm->response_seq;

    if (bridge_inflight) {
        if (req_seq != bridge_inflight_seq) {
            dthc_bridge_fault(__comp_inst, DTHC_UPDATE_ERR_OVERRUN);
            return 0;
        }
        /*
         * Bootloader exchanges are intentionally half-duplex at the packet
         * level: command frame this servo cycle, response frame on a later
         * poll cycle.  Keep the userspace request open and clock zero frames
         * until read() sees a valid response.
         */
        dthc_bridge_zero_tram(__comp_inst);
        update_state = DTHC_UPDATE_BRIDGE_BUSY;
        dthc_bridge_publish(__comp_inst);
        return 0;
    }

    if (req_seq != resp_seq) {
        dthc_bridge_copy_from_volatile(tx_frame, shm->request_frame);
        dthc_frame_to_tram(__comp_inst, tx_frame);
        comm_last_tx_cmd = tx_frame[2];
        bridge_inflight = 1;
        bridge_discard_next_read = 1;
        bridge_inflight_seq = req_seq;
        update_state = DTHC_UPDATE_BRIDGE_BUSY;
    } else {
        dthc_bridge_zero_tram(__comp_inst);
        update_state = DTHC_UPDATE_BRIDGE_READY;
    }

    dthc_bridge_publish(__comp_inst);
    return 0;
}

static int dthc_bridge_read(struct __comp_state *__comp_inst)
{
    dthc_bspi_bridge_shm_t *shm = dthc_bridge_shm(__comp_inst);
    const uint8_t *payload = 0;
    uint8_t cmd = 0;
    uint8_t payload_len = 0;
    int frame_state;

    dthc_tram_to_frame(__comp_inst, rx_frame);

    if (!shm || !bridge_inflight)
        return 0;

    if (bridge_discard_next_read) {
        bridge_discard_next_read = 0;
        return 0;
    }

    frame_state = dthc_validate_frame(rx_frame, &cmd, &payload, &payload_len);
    (void)cmd;
    (void)payload;
    (void)payload_len;

    if (frame_state != DTHC_FRAME_OK) {
        /*
         * All-zero polls are expected while the bootloader is still
         * processing a flash command.  A malformed non-zero frame usually
         * means the target has gone byte-shifted or returned a corrupt
         * response.  Complete the userspace exchange with the bad frame so
         * dthc6_fwupdater can log the raw bytes and retry instead of leaving
         * the bridge stuck in-flight until userspace times out.
         */
        if (dthc_frame_has_nonzero_byte(rx_frame)) {
            dthc_bridge_copy_to_volatile(shm->response_frame, rx_frame);
            shm->response_status = frame_state;
            shm->response_seq = bridge_inflight_seq;

            bridge_inflight = 0;
            bridge_discard_next_read = 0;
            if (update_enable && update_state != DTHC_UPDATE_FAULT)
                update_state = DTHC_UPDATE_BRIDGE_READY;
            dthc_bridge_publish(__comp_inst);
            return 0;
        }
        update_state = DTHC_UPDATE_BRIDGE_BUSY;
        dthc_bridge_publish(__comp_inst);
        return 0;
    }

    dthc_bridge_copy_to_volatile(shm->response_frame, rx_frame);
    shm->response_status = frame_state;
    shm->response_seq = bridge_inflight_seq;

    bridge_inflight = 0;
    bridge_discard_next_read = 0;
    if (update_enable && update_state != DTHC_UPDATE_FAULT)
        update_state = DTHC_UPDATE_BRIDGE_READY;
    dthc_bridge_publish(__comp_inst);
    return 0;
}

/* ================================================================
 * Z-axis position tracking
 * ================================================================ */
static void dthc_update_zpos(struct __comp_state *__comp_inst)
{
    double spu = (fb_motor_steps_per_unit > 0)
                 ? (double)fb_motor_steps_per_unit : 1.0;

    if (!status_mtr_external) {
        /* Firmware is controlling Z via its internal stepper */
        thc_zcntrl_int = 1;
        thc_zpos_out   = thc_zpos_in + ((double)data_step_delta / spu);
    } else {
        /* LinuxCNC is controlling Z */
        thc_zcntrl_int = 0;
        thc_zpos_out   = thc_zpos_in;
    }

    /* Detect the firmware handing Z back to external control */
    if (status_mtr_external && !prev_mtr_external) {
        /* 0 -> 1 transition: capture the accumulated offset */
        thc_zpos_final        = (double)data_step_delta / spu;
        thc_zsync_ready       = 1;
        pending_reset_step_delta = 1;  /* tell firmware to reset its counter */
        zsync_step_counter    = 1;
    }
    prev_mtr_external = status_mtr_external;

    /* Auto-clear zpos-final after two cycles so it's a brief pulse */
    if (zsync_step_counter) {
        if (++zsync_step_counter > 2) {
            thc_zpos_final     = 0.0;
            thc_zsync_ready    = 0;
            zsync_step_counter = 0;
        }
    }
}

/* ================================================================
 * Stop-on-fault
 * ================================================================ */
static void dthc_update_fault(struct __comp_state *__comp_inst)
{
    if (status_fault) {
        if (!thc_err_displayed) {
            if (!thc_prog_is_idle && !ignore_scodes && thc_stop_on_fault) {
                thc_prog_stop_out = 1;
            }
            thc_err_displayed = 1;
        }
    } else {
        thc_prog_stop_out = 0;
        thc_err_displayed = 0;
    }
}

/* ================================================================
 * THC enable toggle
 * ================================================================ */
static void dthc_set_enable(struct __comp_state *__comp_inst, unsigned enable)
{
    internal_enable  = enable ? 1 : 0;
    thc_disable_out  = internal_enable ? 0 : 1;
}

static void dthc_update_enable_toggle(struct __comp_state *__comp_inst)
{
    unsigned cur = thc_enable_toggle ? 1 : 0;
    if (cur && !prev_enable_toggle) {
        dthc_set_enable(__comp_inst, !internal_enable);
        thc_enable_toggle = 0;
    }
    prev_enable_toggle = cur;
}

/* ================================================================
 * Manual / auto mode toggle
 * ================================================================ */
static void dthc_update_manual_auto(struct __comp_state *__comp_inst)
{
    unsigned cur = thc_manual_auto_toggle ? 1 : 0;
    if (cur && !prev_manual_auto_toggle) {
        ignore_scodes = !ignore_scodes;
        thc_manual_auto_toggle = 0;
    }
    prev_manual_auto_toggle = cur;

    thc_manual_mode = ignore_scodes ? 1 : 0;
    thc_auto_mode   = ignore_scodes ? 0 : 1;
}

/* ================================================================
 * Hypertherm command outputs
 * Publishes requested current and pressure to HAL-connected consumers.
 * Current follows the legacy S10x/S20x percentage scaling used by dthc4.
 * ================================================================ */
static void dthc_update_hypertherm_outputs(struct __comp_state *__comp_inst)
{
    uint32_t pct = plasma_current_percent ? plasma_current_percent : 10u;
    uint64_t scaled_current = thc_current_cmd;

    if (pct > 10u)
        pct = 10u;
    if (pct < 10u)
        scaled_current = ((scaled_current * pct) + 5u) / 10u;

    thc_hyt_current  = (uint32_t)scaled_current;
    thc_hyt_pressure = thc_air_pressure;
}

/* ================================================================
 * Gcode command decoder
 * Connects to motion.analog-out-00 which carries integer command
 * codes similar to old-style S-codes. Only acts on value changes.
 * ================================================================ */
static void dthc_handle_gcode_cmd(struct __comp_state *__comp_inst)
{
    double gcmd = thc_gcode_cmd;
    int    icmd;

    if (gcmd == last_gcode_cmd)
        return;
    last_gcode_cmd = gcmd;

    if (gcmd < 10.0)
        return;

    icmd = (int)gcmd;

    if (icmd >= 10 && icmd < 20) {
        /* S10x: set plasma current% = x, disable THC */
        plasma_current_percent = (unsigned)(icmd - 10);
        if (!ignore_scodes && !dcc_thc_disable)
            dthc_set_enable(__comp_inst, 0);
    }
    else if (icmd >= 20 && icmd < 30) {
        /* S20x: set plasma current% = x, enable THC */
        plasma_current_percent = (unsigned)(icmd - 20);
        if (!ignore_scodes && !dcc_thc_disable)
            dthc_set_enable(__comp_inst, 1);
    }
    else if (icmd >= 50 && icmd < 60) {
        /* S50x: delay = (s - 50) / 10.0 seconds */
        cfg_thc_delay = (gcmd - 50.0) / 10.0;
        pending_thc_config_write = 1;
    }
    else if (icmd >= 500 && icmd < 600) {
        /* S500-599: delay in tenths, clamped to 10 s */
        cfg_thc_delay = (gcmd - 500.0) / 10.0;
        if (cfg_thc_delay > 10.0) cfg_thc_delay = 10.0;
        pending_thc_config_write = 1;
    }
    else if (icmd >= 300 && icmd < 400) {
        /* S300-399: setpoint = s - 300 volts */
        cfg_thc_set_point = (unsigned)(icmd - 300);
        pending_thc_config_write = 1;
    }
    else if (icmd >= 3000 && icmd < 3256) {
        /* S3000-3255: setpoint = s - 3000 volts */
        cfg_thc_set_point = (unsigned)(icmd - 3000);
        pending_thc_config_write = 1;
    }
    else if (icmd >= 400 && icmd < 500) {
        /* S400-499: plasma current in amps */
        thc_current_cmd = (unsigned)(icmd - 400);
    }
    else if (icmd >= 4000 && icmd < 4255) {
        /* S4000-4254: plasma current in amps */
        thc_current_cmd = (unsigned)(icmd - 4000);
    }
    else if (icmd >= 800 && icmd < 900) {
        /* S800-899: air pressure command */
        thc_air_pressure = (unsigned)(icmd - 800);
    }
    else if (icmd >= 8000 && icmd < 9000) {
        /* S8000-8999: air pressure command */
        thc_air_pressure = (unsigned)(icmd - 8000);
    }
    else if (icmd == 80) {
        /* Enable autoset */
        cmd_enable_autoset = 1;
    }
    else if (icmd == 81) {
        /* One-shot autoset */
        pending_do_autoset = 1;
    }
    else if (icmd == 89) {
        /* Disable autoset */
        cmd_enable_autoset = 0;
    }
    else if (icmd == 90) {
        /* Enable THC */
        if (!ignore_scodes)
            dthc_set_enable(__comp_inst, 1);
    }
    else if (icmd == 99) {
        /* Disable THC */
        if (!ignore_scodes)
            dthc_set_enable(__comp_inst, 0);
    }
    else if (icmd == 900) {
        /* Enable THC + clear DCC disable */
        dcc_thc_disable = 0;
        if (!ignore_scodes)
            dthc_set_enable(__comp_inst, 1);
    }
    else if (icmd == 999) {
        /* Disable THC + set DCC disable */
        dcc_thc_disable = 1;
        if (!ignore_scodes)
            dthc_set_enable(__comp_inst, 0);
    }
}

/* ================================================================
 * VAD / XY-accel auto-delay calculation
 * ================================================================ */
static void dthc_update_auto_delay(struct __comp_state *__comp_inst)
{
    unsigned vad_en  = thc_vad_enabled ? 1 : 0;
    int      vad_pct = thc_vad_percent;
    double   accel   = thc_xy_accel;

    if (vad_en  == prev_vad_enabled &&
        vad_pct == prev_vad_percent  &&
        accel   == prev_xy_accel)
        return;

    prev_vad_enabled = vad_en;
    prev_vad_percent = vad_pct;
    prev_xy_accel    = accel;

    if (accel <= 0.0)
        return;

    /* Time to reach 350 ipm (5.8333 in/s) at the given acceleration */
    thc_auto_delay = 5.8333 / accel;
    if (vad_en && vad_pct > 0)
        thc_auto_delay -= thc_auto_delay * ((double)vad_pct / 100.0);

    cfg_autoset_delay = thc_auto_delay;
    pending_autosettings_write = 1;

    if (thc_autodelay)
        pending_thc_config_write = 1;
}

/* ================================================================
 * Autosettings tolerance change detection
 * ================================================================ */
static void dthc_check_autosettings(struct __comp_state *__comp_inst)
{
    if (cfg_autoset_upper_tol != prev_aset_upper_tol ||
        cfg_autoset_lower_tol != prev_aset_lower_tol) {
        prev_aset_upper_tol = cfg_autoset_upper_tol;
        prev_aset_lower_tol = cfg_autoset_lower_tol;
        pending_autosettings_write = 1;
    }
    /* The response trim travels with the THC config (firmware 2.3); send
     * it whenever the panel changes it, once the firmware revision is
     * known. */
    if (comm_config_valid && (fw_app_rev >= DTHC_AUTO_FW_REV) &&
        (cfg_thc_response_trim != prev_response_trim)) {
        prev_response_trim = cfg_thc_response_trim;
        pending_thc_config_write = 1;
    }
}

/* ================================================================
 * write() - called each servo cycle to queue the next TX frame
 * and run all per-cycle HAL logic.
 * ================================================================ */
static int write(void *subdata)
{
    struct __comp_state *__comp_inst = subdata;
    uint8_t payload[DTHC_SPI_PAYLOAD_MAX];
    uint8_t payload_len = 0;
    uint8_t cmd = 0;

    logging_compatible = (dthc_voltage_stream_ready &&
                          fw_app_rev >= DTHC_VOLTAGE_HISTORY_FW_REV) ? 1 : 0;

    if (update_enable || update_state != DTHC_UPDATE_RUN) {
        motor_test_armed = 0;
        return dthc_bridge_write(__comp_inst);
    }

    /* Online countdown */
    if (comm_online_timeout_cycles > 0) {
        if (online_countdown > 0)
            online_countdown--;
        comm_online = (online_countdown > 0) ? 1 : 0;
    } else {
        comm_online = 0;
    }

    /* ---- Z-position (always, even offline) ---- */
    dthc_update_zpos(__comp_inst);

    /* ---- Enable toggle ---- */
    dthc_update_enable_toggle(__comp_inst);

    /* ---- Manual/auto toggle ---- */
    dthc_update_manual_auto(__comp_inst);

    /* ---- Gcode command decoding ---- */
    dthc_handle_gcode_cmd(__comp_inst);

    /* ---- Hypertherm HAL outputs ---- */
    dthc_update_hypertherm_outputs(__comp_inst);

    /* ---- Stop-on-fault ---- */
    dthc_update_fault(__comp_inst);

    /* ---- VAD / auto-delay ---- */
    dthc_update_auto_delay(__comp_inst);

    /* ---- Autosettings tolerance change ---- */
    dthc_check_autosettings(__comp_inst);

    /* ---- Edge-detect one-shot cmd.* pins ---- */
    if (cmd_reset_step_delta && !prev_reset_step_delta)
        pending_reset_step_delta = 1;
    prev_reset_step_delta = cmd_reset_step_delta ? 1 : 0;

    if (cmd_do_autoset && !prev_do_autoset)
        pending_do_autoset = 1;
    prev_do_autoset = cmd_do_autoset ? 1 : 0;

    if (cmd_request_config && !prev_request_config)
        pending_config_read = 1;
    prev_request_config = cmd_request_config ? 1 : 0;

    if (cmd_write_thc_config && !prev_write_thc_config)
        pending_thc_config_write = 1;
    prev_write_thc_config = cmd_write_thc_config ? 1 : 0;

    if (cmd_write_motor_config && !prev_write_motor_config)
        pending_motor_config_write = 1;
    prev_write_motor_config = cmd_write_motor_config ? 1 : 0;

    if (cmd_write_autosettings && !prev_write_autosettings)
        pending_autosettings_write = 1;
    prev_write_autosettings = cmd_write_autosettings ? 1 : 0;

    if (cmd_request_control_profile && !prev_request_control_profile &&
        (fw_app_rev >= DTHC_PROFILE_FW_REV)) {
        profile_action = DTHC_PROFILE_READ;
        profile_page = 0u;
        profile_waiting = 0u;
        /* A new read must not leave the previous snapshot marked valid.
         * Commissioning clients wait for read-sequence to advance. */
        fb_profile_valid = 0;
        fb_profile_last_status = 0u;
    }
    prev_request_control_profile = cmd_request_control_profile ? 1 : 0;

    if (cmd_write_control_profile && !prev_write_control_profile &&
        fb_profile_valid && thc_prog_is_idle && !status_torch_on &&
        !update_enable && (fw_app_rev >= DTHC_PROFILE_FW_REV)) {
        dthc_pins_to_profile(__comp_inst);
        profile_action = DTHC_PROFILE_WRITE;
        profile_page = 0u;
        profile_waiting = 0u;
        fb_profile_valid = 0;
        fb_profile_last_status = 0u;
    }
    prev_write_control_profile = cmd_write_control_profile ? 1 : 0;

    /* Staging does not change the live profile. If a run or torch starts
     * before commit, leave the staged bytes uncommitted. The next write
     * stages every page afresh. */
    if ((profile_action == DTHC_PROFILE_WRITE ||
         profile_action == DTHC_PROFILE_COMMIT) &&
        (!thc_prog_is_idle || status_torch_on || update_enable)) {
        profile_action = DTHC_PROFILE_NONE;
        profile_waiting = 0u;
        fb_profile_valid = 0;
        fb_profile_last_status = 5u;
    }

    if (trace_age_cycles < 0xffffffffu)
        trace_age_cycles++;
    if (profile_waiting && ++profile_wait_cycles > 100u) {
        profile_waiting = 0u;
        profile_wait_cycles = 0u;
    }
    if (!comm_online || (trace_age_cycles > 50u) ||
        !(trace_mode_flags & 0x01u)) {
        control_feed_scale_candidate = 1.0;
        control_feed_scale_applied = 1.0;
    } else if (trace_mode_flags & 0x10u) {
        control_feed_scale_applied = control_feed_scale_candidate;
    } else {
        control_feed_scale_applied = 1.0;
    }

    /* ---- SPI command sequencing (highest priority first) ---- */
    if ((profile_action != DTHC_PROFILE_NONE) && !profile_waiting) {
        cmd = DTHC_SPI_CMD_PROFILE;
        payload_len = dthc_build_profile_payload(__comp_inst, payload);
        profile_waiting = 1u;
        profile_wait_cycles = 0u;
    } else if (pending_thc_config_write) {
        cmd = DTHC_SPI_CMD_CONF_SET;
        payload_len = dthc_build_thc_config_payload(__comp_inst, payload);
        pending_thc_config_write = 0;
        pending_config_read = 1;
    } else if (pending_motor_config_write) {
        cmd = DTHC_SPI_CMD_CONF_SET;
        payload_len = dthc_build_motor_config_payload(__comp_inst, payload);
        pending_motor_config_write = 0;
        pending_config_read = 1;
    } else if (pending_autosettings_write) {
        cmd = DTHC_SPI_CMD_AUTOSETTINGS;
        payload_len = dthc_build_autosettings_payload(__comp_inst, payload);
        pending_autosettings_write = 0;
    } else if (pending_config_read) {
        cmd = DTHC_SPI_CMD_CONFIG;
        pending_config_read = 0;
    } else if (++trace_cycle >= (logging_enable ? 10u : 4u) &&
               (fw_app_rev >= DTHC_OBSERVER_FW_REV)) {
        cmd = DTHC_SPI_CMD_TRACE;
        trace_cycle = 0u;
    } else {
        cmd = DTHC_SPI_CMD_DATA;
        payload_len = dthc_build_data_payload(__comp_inst, payload);
    }

    dthc_queue_frame(__comp_inst, cmd, payload, payload_len);
    return 0;
}

/* ================================================================
 * read() - called each servo cycle to parse the latest RX frame.
 * ================================================================ */
static int read(void *subdata)
{
    struct __comp_state *__comp_inst = subdata;
    const uint8_t *payload = 0;
    uint8_t cmd = 0;
    uint8_t payload_len = 0;
    int frame_state;

    if (update_enable || update_state != DTHC_UPDATE_RUN)
        return dthc_bridge_read(__comp_inst);

    dthc_tram_to_frame(__comp_inst, rx_frame);
    frame_state = dthc_validate_frame(rx_frame, &cmd, &payload, &payload_len);

    if (frame_state != DTHC_FRAME_OK) {
        comm_bad_frames++;
        if      (frame_state == DTHC_FRAME_BAD_SOF)    comm_bad_sof++;
        else if (frame_state == DTHC_FRAME_BAD_LENGTH)  comm_bad_length++;
        else if (frame_state == DTHC_FRAME_BAD_CRC)     comm_bad_crc++;
        return 0;
    }

    comm_good_frames++;
    comm_last_rx_cmd = cmd;
    online_countdown = comm_online_timeout_cycles;
    comm_online = (online_countdown > 0) ? 1 : 0;

    switch (cmd) {
    case 0:
        break;
    case DTHC_SPI_CMD_DATA:
        dthc_parse_data_reply(__comp_inst, payload, payload_len);
        break;
    case DTHC_SPI_CMD_CONFIG:
        dthc_parse_config_reply(__comp_inst, payload, payload_len);
        break;
    case DTHC_SPI_CMD_AUTOSETTINGS:
        dthc_parse_autosettings_reply(__comp_inst, payload, payload_len);
        break;
    case DTHC_SPI_CMD_PROFILE:
        dthc_parse_profile_reply(__comp_inst, payload, payload_len);
        break;
    case DTHC_SPI_CMD_TRACE:
        dthc_parse_trace_reply(__comp_inst, payload, payload_len);
        break;
    default:
        comm_unexpected_cmd++;
        break;
    }

    return 0;
}

/* ================================================================
 * EXTRA_SETUP
 * ================================================================ */
EXTRA_SETUP()
{
    int i, r = 0;
    dthc_bspi_bridge_shm_t *shm = 0;

    dthc_bridge_shmem_id = -1;
    bridge_shmem_ptr = 0;

    if (bspi_chan == 0 || *bspi_chan == '\0') {
        rtapi_print_msg(RTAPI_MSG_ERR,
            "ccc_dthc_bspi: bspi_chan must be set\n");
        return -EINVAL;
    }

    //hm2_bspi_setup_chan(name, chan, cs, bits, mhz, delay(ns), cpol, cpha, /clear, /echo, samplelate)
    r = hm2_bspi_setup_chan(bspi_chan, DTHC_SPI_BSPI_CHANNEL, spi_cs, 32,
                            (spi_mhz/10.0), spi_delay_ns, spi_cpol,
                            spi_cpha, 0, 0, spi_samplelate);
    if (r < 0) {
        rtapi_print_msg(RTAPI_MSG_ERR,
            "ccc_dthc_bspi: BSPI channel setup failed on %s\n", bspi_chan);
        return -EINVAL;
    }

    r = hm2_bspi_clear_fifo(bspi_chan);
    if (r < 0) {
        rtapi_print_msg(RTAPI_MSG_ERR,
            "ccc_dthc_bspi: failed to clear BSPI FIFOs on %s\n", bspi_chan);
        return -EINVAL;
    }

    for (i = 0; i < DTHC_SPI_TRAM_SLOTS; i++)
        r += hm2_tram_add_bspi_frame(bspi_chan, DTHC_SPI_BSPI_CHANNEL,
                                     &tram_write[i], &tram_read[i]);

    r += hm2_allocate_bspi_tram(bspi_chan);
    r += hm2_bspi_set_write_function(bspi_chan, &write, __comp_inst);
    r += hm2_bspi_set_read_function(bspi_chan, &read,  __comp_inst);
    if (r < 0) {
        rtapi_print_msg(RTAPI_MSG_ERR,
            "ccc_dthc_bspi: TRAM setup failed on %s\n", bspi_chan);
        return -EINVAL;
    }

    dthc_bridge_shmem_id = rtapi_shmem_new(DTHC_BSPI_BRIDGE_SHMEM_KEY, comp_id,
                                      sizeof(dthc_bspi_bridge_shm_t));
    if (dthc_bridge_shmem_id < 0) {
        rtapi_print_msg(RTAPI_MSG_ERR,
            "ccc_dthc_bspi: failed to create DTHC6 update bridge shmem\n");
        return -EINVAL;
    }
    r = rtapi_shmem_getptr(dthc_bridge_shmem_id, &bridge_shmem_ptr);
    if (r < 0 || bridge_shmem_ptr == 0) {
        rtapi_print_msg(RTAPI_MSG_ERR,
            "ccc_dthc_bspi: failed to map DTHC6 update bridge shmem\n");
        rtapi_shmem_delete(dthc_bridge_shmem_id, comp_id);
        dthc_bridge_shmem_id = -1;
        return -EINVAL;
    }
    shm = (dthc_bspi_bridge_shm_t *)bridge_shmem_ptr;
    memset(shm, 0, sizeof(*shm));
    shm->magic = DTHC_BSPI_BRIDGE_MAGIC;
    shm->abi_version = DTHC_BSPI_BRIDGE_ABI;
    shm->struct_size = sizeof(*shm);
    shm->bridge_state = DTHC_UPDATE_RUN;
    shm->bridge_error = DTHC_UPDATE_ERR_NONE;

    /* ---- Prime TX TRAM with idle frame ---- */
    dthc_build_frame(tx_frame, 0, 0, 0);
    dthc_frame_to_tram(__comp_inst, tx_frame);

    /*
     * NOTE: Do NOT write to HAL pins here.  halcompile calls EXTRA_SETUP()
     * before pins are exported, so all pin pointers are still NULL at this
     * point.  Pins default to 0; non-zero defaults (thc.disable-out,
     * thc.auto-mode) are set via the pin declaration's "= value" syntax.
     *
     * Instance variables (struct members, not pin pointers) are safe to set
     * here.  The struct is memset to 0 before EXTRA_SETUP, so only non-zero
     * values need explicit assignment.
     */

    /* ---- Pending command state ---- */
    pending_config_read        = 1;  /* request config on first cycle */
    pending_autosettings_write = 1;  /* send autosettings on first cycle */

    /* ---- Gcode command ---- */
    last_gcode_cmd         = -1.0;
    plasma_current_percent = 10;

    /* ---- Autosettings change tracking ---- */
    prev_aset_upper_tol = -1.0;
    prev_aset_lower_tol = -1.0;
    prev_response_trim = 0x7fffffff;  /* send the panel's trim once */

    r = hal_stream_create(&dthc_voltage_stream, comp_id,
                          DTHC_VOLTAGE_STREAM_KEY,
                          DTHC_VOLTAGE_STREAM_DEPTH,
                          DTHC_VOLTAGE_STREAM_TYPES);
    if (r < 0) {
        dthc_voltage_stream_ready = 0;
        rtapi_print_msg(RTAPI_MSG_WARN,
            "ccc_dthc_bspi: voltage-history stream unavailable (%d); logging disabled\n",
            r);
    } else {
        dthc_voltage_stream_ready = 1;
    }

    return 0;
}

EXTRA_CLEANUP()
{
    if (dthc_voltage_stream_ready) {
        hal_stream_destroy(&dthc_voltage_stream);
        dthc_voltage_stream_ready = 0;
    }
    if (dthc_bridge_shmem_id >= 0)
        rtapi_shmem_delete(dthc_bridge_shmem_id, comp_id);
}
