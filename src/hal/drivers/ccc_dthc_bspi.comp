component ccc_dthc_bspi "CandCNC DTHC6 BSPI master for hostmot2";

description """
This component drives the CandCNC DTHC6 SPI protocol over a HostMot2 BSPI
instance. It follows the packet format built by spi_send_frame() in
the DTHC6 firmware:

  [0] SOF (0x55)
  [1] LENGTH = N
  [2] COMMAND
  [3..N-1] PAYLOAD
  [N] CRC-8 over bytes [0..N-1]

The component queues twelve 32-bit BSPI echo transfers to move the full
48-byte packet every servo cycle. HostMot2 TRAM buffers are 32-bit wide,
so each packet word carries four bytes. Write-side pins live under cfg.* and
cmd.*. Readback pins live under fb.*, data.* and status.*. Voltage-history
samples are forwarded through a private HAL stream for userspace logging.

CMD_DATA requests carry a control-flags byte (bit-packed):
  bit 0 : motor_up
  bit 1 : thc_enable  (only used when use_enable_pin is 0)
  bit 2 : reset_step_delta
  bit 3 : torch_off
  bit 4 : enable_autoset
  bit 5 : do_autoset
  bit 6 : use_enable_pin  (defer enable/disable to hardware pin)
  bit 7 : motor_down

Firmware revision 1.1 and newer accepts an optional second CMD_DATA byte:
  byte 1: XY-derived response scale, 0..255 (255 = established full response)

When velocity anti-dive is enabled and a commanded XY velocity is available,
the component derives this scale from actual / commanded XY velocity. Older
firmware ignores the extra byte; older one-byte hosts leave revision 1.1
firmware at its backward-compatible full response.

Firmware revision 2.0 appends runtime validity, commanded/actual scalar XY
velocity, and a host sequence number after those two legacy bytes. It also
adds paged profile and observer-trace commands. High-rate voltage history is
requested only while logging.enable is true; normal operation uses trace
telemetry instead.

Firmware revision 1.0 and newer CMD_DATA replies carry packed inline voltage
history after the base fields. Each packed u16 contains Q4 volts in bits 0..13,
ArcOK in bit 14 and torch state in bit 15. Revision 2.1's version-3 history
uses bit 13 for sampled THC enable and bits 0..12 for voltage; older responses
keep the original voltage range.

Z-axis position tracking:
  When status.mtr-external is false the firmware controls Z via its internal
  stepper.  thc.zpos-out = thc.zpos-in + data.step-delta / fb.motor.steps-per-unit.
  When the firmware returns Z control to LinuxCNC (status.mtr-external goes
  false -> true) the component captures the accumulated offset in thc.zpos-final,
  asserts thc.zsync-ready for two servo cycles, and queues a reset-step-delta
  so the firmware counter zeroes out.

gcode-cmd decoding (connect to motion.analog-out-00):
  S10x  : current% = x, disable THC
  S20x  : current% = x, enable  THC
  S50x / S500-599 : set THC delay (tenths of sec)
  S300-399 / S3000-3255 : set setpoint (volts)
  S80   : enable autoset
  S81   : one-shot autoset
  S89   : disable autoset
  S90   : enable  THC
  S99   : disable THC
  S900  : enable  THC + clear DCC-disable
  S999  : disable THC + set  DCC-disable
  S400-499 / S4000-4254 : Hypertherm plasma current in amps -> thc.current-cmd
  S800-899 / S8000-8999 : Hypertherm air pressure          -> thc.air-pressure
""";

/* ---- SPI control flags sent with every CMD_DATA request ---- */
pin in bit cmd.motor-up "Momentary DTHC6 internal-motor up command (bit 0)";
pin in bit cmd.motor-down "Momentary DTHC6 internal-motor down command (bit 7)";
pin in bit cmd.machine-is-on "Machine power interlock for internal-motor test";
pin in bit cmd.use-enable-pin "Defer enable to hardware input pin (bit 6). Normally 1.";
pin in bit cmd.reset-step-delta "One-shot: zero the firmware step-delta counter";
pin in bit cmd.torch-off "Torch-off command (bit 3)";
pin in bit cmd.do-autoset "One-shot autoset trigger (bit 5)";
pin io bit cmd.enable-autoset "Continuous autoset enable (bit 4); writable so gcode-cmd S80/S89 can update it";

/* ---- One-shot config commands ---- */
pin in bit cmd.request-config "One-shot: request the full configuration frame from firmware";
pin in bit cmd.write-thc-config "One-shot: write cfg.thc.* to firmware";
pin in bit cmd.write-motor-config "One-shot: write cfg.motor.* to firmware";
pin in bit cmd.write-autosettings "One-shot: write cfg.autoset.* and read back applied values";
pin in bit cmd.request-control-profile "One-shot: read the versioned observer control profile";
pin in bit cmd.write-control-profile "One-shot: stage, CRC-check and commit cfg.control.* while torch off and program idle";

/* ---- Versioned observer control profile ---- */
pin io u32 cfg.control.qualification-flags "Qualification bits: observer=1, target=2, slowdown=4";
pin io u32 cfg.control.observer-mode "0 Legacy, 1 Shadow, 2 Active, 3 Auto (firmware 2.3)";
pin io u32 cfg.control.target-mode "0 Off, 1 Shadow, 2 Active";
pin io u32 cfg.control.slowdown-mode "0 Off, 1 Shadow, 2 Active";
pin io float cfg.control.feedforward-cap "Maximum fraction of w-hat applied in Observer Active";
pin io float cfg.control.deadzone-min "Minimum scheduled deadzone in volts";
pin io float cfg.control.deadzone-max "Maximum scheduled deadzone in volts";
pin io float cfg.control.kquiet-per-s "Near-zero recovery slope";
pin io float cfg.control.e-nominal-up-mm;
pin io float cfg.control.e-high-up-mm;
pin io float cfg.control.e-nominal-down-mm;
pin io float cfg.control.e-high-down-mm;
pin io float cfg.control.observer-alpha;
pin io float cfg.control.observer-beta;
pin io float cfg.control.residual-clip-mm;
pin io float cfg.control.observer-decay;
pin io u32 cfg.control.confidence-rise;
pin io u32 cfg.control.confidence-fall;
pin io float cfg.control.confidence-min-apply;
pin io u32 cfg.control.conf-evidence-ms;
pin io float cfg.control.vad-down-min;
pin io float cfg.control.vad-lock;
pin io float cfg.control.vad-unlock;
pin io float cfg.control.target-k "Universal point-9 target coefficient";
pin io float cfg.control.target-max-offset "Maximum point-9 voltage offset";
pin io float cfg.control.target-filter;
pin io float cfg.control.target-slew-volts-s;
pin io float cfg.control.slowdown-min-scale "Minimum point-10 adaptive-feed recommendation";
pin io float cfg.control.slowdown-z-margin;
pin io float cfg.control.slowdown-attack;
pin io float cfg.control.slowdown-release;
pin io float cfg.control.slowdown-min-conf;
pin io u32 cfg.control.slowdown-delay-ms;
pin io u32 cfg.control.slowdown-min-on-ms;
pin io u32 cfg.control.slowdown-timeout-ms;
/* Auto law, profile version 4 (firmware 2.3). */
pin io u32 cfg.control.loop-delay-ms "Auto: voltage-to-Z loop delay used to derive every gain";
pin io float cfg.control.brake-accel-fraction "Auto: fraction of Z acceleration the recovery curve brakes with";
pin io u32 cfg.control.auto-flags "Auto: 1 kerf hold, 2 use the measured loop delay";
pin io float cfg.control.kerf-threshold "Auto: unexplained voltage rise (V) that holds downward motion";
pin io u32 cfg.control.kerf-hold-max-ms "Auto: longest kerf/edge hold";
pin io float cfg.control.transition-error-mm "Auto: point-10 error budget for an abrupt end of slope; 0 disables";
pin out bit fb.profile.valid;
pin out bit fb.profile.provisional;
pin out bit fb.profile.fault;
pin out u32 fb.profile.generation;
pin out u32 fb.profile.crc;
pin out u32 fb.profile.length;
pin out u32 fb.profile.last-status "0 success; 1 request; 2 torch; 3 validation; 4 CRC readback; 5 host interlock abort";
pin out u32 fb.profile.read-sequence "Increments after a complete CRC-checked profile readback";

/* ---- THC tuning parameters (input from INI or GUI) ---- */
pin in float cfg.thc.deadband "Deadband in volts";
pin in s32 cfg.thc.response-trim "Auto law response: -1 Smoother, 0 Auto, 1 Tighter (firmware 2.3)";
pin io float cfg.thc.delay "Delay in seconds (writable so gcode-cmd S5xx can update it)";
pin io u32 cfg.thc.set-point "Set point in volts (writable so gcode-cmd S3xx can update it)";
pin in u32 cfg.thc.upper-limit "Upper fault limit in volts";
pin in u32 cfg.thc.lower-limit "Lower fault limit in volts";
pin in u32 cfg.thc.arcok-current "Arc-ok current threshold";
pin in u32 cfg.thc.minvel "Minimum velocity";
pin in u32 cfg.thc.pgain "P gain";
pin in u32 cfg.thc.igain "I gain";
pin in u32 cfg.thc.dgain "D gain";

/* ---- THC tuning readback from firmware ---- */
pin out float fb.thc.deadband;
pin out s32 fb.thc.response-trim;
pin out float fb.thc.delay;
pin out u32 fb.thc.set-point;
pin out u32 fb.thc.upper-limit;
pin out u32 fb.thc.lower-limit;
pin out u32 fb.thc.arcok-current;
pin out u32 fb.thc.minvel;
pin out u32 fb.thc.pgain;
pin out u32 fb.thc.igain;
pin out u32 fb.thc.dgain;

/* ---- Motor / Z-axis parameters ---- */
pin in u32 cfg.motor.steps-per-unit;
pin in u32 cfg.motor.max-up-velocity;
pin in u32 cfg.motor.max-down-velocity;
pin in u32 cfg.motor.acceleration;
pin in bit cfg.motor.dir-up-polarity "DTHC5-compatible MOTOR_REVERSE setting";
pin in bit cfg.motor.step-polarity "DTHC5-compatible MOTOR_STEP_LOW setting (1 = active-low motor output)";
pin in bit cfg.motor.metric-units;

pin out u32 fb.motor.steps-per-unit;
pin out u32 fb.motor.max-up-velocity;
pin out u32 fb.motor.max-down-velocity;
pin out u32 fb.motor.acceleration;
pin out bit fb.motor.dir-up-polarity;
pin out bit fb.motor.step-polarity;
pin out bit fb.motor.metric-units;

/* ---- Autoset parameters ---- */
pin io float cfg.autoset.upper-tol "Autoset upper tolerance in volts";
pin io float cfg.autoset.lower-tol "Autoset lower tolerance in volts";
pin io float cfg.autoset.delay "Autoset delay in seconds (written by auto-delay calculation)";

pin out float fb.autoset.upper-tol;
pin out float fb.autoset.lower-tol;
pin out float fb.autoset.delay;

/* ---- Live data from firmware ---- */
pin out u32 data.tip-volts "Measured arc voltage in volts";
pin out u32 data.current "Measured arc current";
pin out float data.tip-volts-precise "Measured arc voltage with Q4 precision";
pin out float data.current-precise "Measured arc current with Q4 precision";
pin out u32 data.target-volts "Active target voltage";
pin out s32 data.step-delta "Accumulated motor step delta from firmware";
pin out u32 fw.app-rev "DTHC6 application firmware revision (FW_REV)";

/* ---- Status word and decoded bits ---- */
pin out u32 status.code "Raw 32-bit firmware status word";
pin out bit status.fault;
pin out bit status.delay;
pin out bit status.tipsave-active;
pin out bit status.enabled;
pin out bit status.tipsave-on;
pin out bit status.eeread-err;
pin out bit status.eewrite-err;
pin out bit status.arcok-on;
pin out bit status.mtrvolt-high;
pin out bit status.mtrvolt-low;
pin out bit status.mtrvolt-off;
pin out bit status.gecko-fault;
pin out bit status.eegood;
pin out bit status.torch-on;
pin out bit status.hold;
pin out bit status.up;
pin out bit status.down;
pin out bit status.mtr-external "Firmware has handed Z control back to LinuxCNC";
pin out bit status.test-mode;
pin out bit status.wd-good;
pin out bit status.as-sample-good;
pin out bit status.as-sample-bad;
pin out bit status.has-autoset "Firmware supports autoset feature";
pin out bit status.debug;
pin out bit status.profile-provisional;
pin out bit status.velocity-stale;
pin out bit status.observer-active;
pin out bit status.target-active;
pin out bit status.slowdown-active;
pin out bit status.profile-fault;
pin out bit status.down-lock;

/* ---- Observer trace and adaptive-feed recommendation ---- */
pin out u32 trace.tick;
pin out u32 trace.reason;
pin out u32 trace.mode-flags;
pin out float trace.base-target;
pin out float trace.adjusted-target;
pin out float trace.target-candidate "Point-9 candidate, including in Shadow mode";
pin out float trace.control-volts;
pin out float trace.g-hat-mm;
pin out float trace.w-hat-mm-s;
pin out float trace.residual-mm;
pin out float trace.feedback-mm-s;
pin out float trace.feedforward-mm-s "Observer feedforward; applied in Observer Active, reported only in Shadow";
pin out float trace.request-mm-s;
pin out float trace.realized-mm-s;
pin out float trace.confidence;
pin out float trace.load;
pin out float trace.rxy;
pin out bit trace.kerf-hold "Auto: downward motion held for a kerf or edge";
pin out float trace.slope "Learned surface slope (rise/run) at actual XY speed";
/* Trace v3 diagnostic slot, refreshed in turn (firmware 2.3). */
pin out u32 trace.compute-max-us "Worst 1 ms observer step time, us, including interrupts";
pin out u32 trace.late-discards "Observer results discarded as late";
pin out u32 trace.late-overwrites "Observer samples overwritten before they started";
pin out u32 trace.kerf-holds "Kerf/edge holds since power-up";
pin out u32 trace.bandwidth "Auto observer bandwidth in rad/s";
pin out u32 trace.loop-delay-ms "Auto loop delay in use";
pin out float trace.noise-mm "Measured gap noise, one sigma";
pin out float trace.delay-estimate "Measured realized-Z-to-voltage delay, ms";
pin out float trace.arc-gain "Measured arc V/mm relative to 1/0.127 (1.0 = as assumed)";
pin out u32 trace.ident-fits "Delay/arc-gain identification windows accepted";
/* Firmware 2.3 diagnostic build: link and fault diagnostics.  Counts are
 * since board power-up; they reset only with power. */
pin out u32 trace.spi-repairs "Replies resynchronised at a frame end (transmit side out of step)";
pin out u32 trace.spi-tx-underflows "Frames whose reply ran dry (board SPI handler late)";
pin out u32 trace.spi-rx-overflows "Frames that lost a received byte (board SPI handler late)";
pin out u32 trace.spi-timeout-resets "Partial frames abandoned and resynchronised";
pin out u32 trace.spi-late-frames "Frame ends handled after the next frame had begun (should stay 0)";
pin out u32 trace.stack-peak "Deepest firmware stack use, bytes (of 2048)";
pin out u32 trace.last-event "Last fault/hang reset: 0 none, 1 HardFault, 2 SysTick stall, 3 main-loop stall, 4 bootloader request";
pin out u32 trace.last-event-context "Exception number running at that event (0 main loop, 15 SysTick, 16+n IRQ n)";
pin out u32 trace.last-event-pc "Code address at that event";
pin out u32 trace.last-event-lr "Return address at that event";
pin out u32 trace.event-count "Fault/hang resets since power-up";
pin out u32 trace.load-fw-rejects "Bootloader requests refused (torch on or malformed)";
pin out float trace.isr-max-motor-us "Longest step-timer interrupt, us";
pin out float trace.isr-max-gpio-us "Longest GPIO/comparator interrupt, us";
pin out float trace.isr-max-spi-us "Longest SPI interrupt, us";
pin out float trace.isr-max-systick-us "Longest SysTick interrupt, us";
pin out float trace.mask-max-us "Longest interrupt-masked section in the 1 ms observer service, us";
pin out float control.feed-scale-candidate;
pin out float control.feed-scale-applied = 1.0 "Connect only in DTHC6 plasma configurations to motion.adaptive-feed";

/* ---- Voltage logging ---- */
pin in bit logging.enable "Forward packed firmware history to the private userspace stream";
pin in float logging.xy-velocity-commanded "Feed-adjusted commanded XY vector velocity";
pin in float logging.xy-velocity-realtime "Actual XY vector velocity from motion.current-vel";
pin out bit logging.compatible "Firmware and host stream support voltage-history logging";
pin out u32 logging.stream-overruns "Samples dropped because the userspace stream was full";

/* ---- Z-axis position tracking ---- */
pin in float thc.zpos-in "Z position input from LinuxCNC (halui.axis.z.pos-relative)";
pin out float thc.zpos-out "Adjusted Z position output (connect to Z DRO / joint fb)";
pin out float thc.zpos-final "Z offset captured when firmware hands back Z control";
pin out bit thc.zcntrl-int "True when firmware is controlling Z (STAT_MTR_EXTERNAL == 0)";
pin in bit thc.zsync-done "LinuxCNC signals it has handled the Z sync (currently unused)";
pin out bit thc.zsync-ready "True for 2 cycles when firmware returns Z to external control";

/* ---- Gcode command input (connect to motion.analog-out-00) ---- */
pin in float thc.gcode-cmd "Gcode command value (encodes S-code style commands for THC control)";

/* ---- Manual / auto mode ---- */
pin io bit thc.manual-auto-toggle "Rising edge toggles between manual and auto mode; cleared by comp";
pin out bit thc.manual-mode "True when in manual mode (S-codes ignored for enable/disable)";
pin io bit thc.auto-mode = 1 "True when in auto mode";

/* ---- THC enable control ---- */
pin io bit thc.enable-toggle "Rising edge toggles THC enable state; cleared by comp";
pin out bit thc.disable-out = 1 "Active when THC is disabled; connect to thcenable.extdisable";

/* ---- Program control ---- */
pin in bit thc.prog-is-idle "Program idle signal from halui.program.is-idle";
pin io bit thc.stop-on-fault "When true, assert prog-stop-out on fault while gcode runs";
pin out bit thc.prog-stop-out "Assert to stop program on fault; connect to halui.program.stop";

/* ---- Velocity anti-dive / auto-delay inputs ---- */
pin in bit thc.vad-enabled "Velocity anti-dive enabled";
pin in s32 thc.vad-percent "VAD percentage (from thcenable.percent)";
pin in float thc.xy-accel "XY axis acceleration in units/sec^2 (used for auto-delay calc)";
pin in bit thc.autodelay "When true, use auto-calculated THC delay instead of cfg.thc.delay";

/* ---- Hypertherm command pins ---- */
pin out u32 thc.hyt-current "Scaled plasma current out to hypertherm; connect to ccc-main.hytconnect.current-cmd";
pin out u32 thc.hyt-pressure "Plasma air pressure out to hypertherm; connect to ccc-main.hytconnect.air-pressure";
pin io u32 thc.current-cmd "Requested plasma current to/from UI";
pin io u32 thc.air-pressure "Requested plasma air pressure to/from UI";

/* ---- Communication diagnostics ---- */
pin out bit comm.online "True while valid frames are still arriving";
pin out bit comm.config-valid "True after at least one valid config reply";
pin out bit comm.autosettings-valid "True after at least one valid autosettings reply";
pin out u32 comm.last-tx-cmd;
pin out u32 comm.last-rx-cmd;
pin out u32 comm.good-frames;
pin out u32 comm.bad-frames;
pin out u32 comm.bad-sof;
pin out u32 comm.bad-crc;
pin out u32 comm.bad-length;
pin out u32 comm.unexpected-cmd;

/* ---- Firmware update bridge ---- */
pin in bit update.enable "Suspend runtime traffic and expose raw BSPI bridge";
pin out bit update.active "True while runtime traffic is suspended for update";
pin out bit update.bridge-ready "True when userspace may exchange raw 48-byte frames";
pin out u32 update.state "Firmware update state: 0 RUN, 1 QUIESCING, 2 BRIDGE_READY, 3 BRIDGE_BUSY, 4 RESTORING, 5 FAULT";
pin out s32 update.error-code "Firmware update bridge error: 0 none, 1 FIFO clear, 2 shmem, 3 overrun, 4 transfer, 5 aborted";

param rw u32 comm.online-timeout-cycles = 100 "Servo cycles to keep comm.online after last good frame";

option extra_setup yes;
option extra_cleanup yes;
option singleton yes;

