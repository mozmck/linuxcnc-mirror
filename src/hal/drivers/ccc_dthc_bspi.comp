/* 21 HAL stream slots: two ticks, packed sample flags, 17 floats, packed trace flags. */
#define DTHC_VOLTAGE_STREAM_TYPES   "uuufffffffffffffffffu"
#define DTHC_VOLTAGE_HISTORY_FW_REV 21u
#define DTHC_OBSERVER_FW_REV        20u
/* Firmware 2.2 removed the fixed 0.127 mm/V scale from the profile. */
#define DTHC_PROFILE_FW_REV         22u
#define DTHC_PROFILE_V3_BYTES       72u
/* Firmware 2.3: Auto law, profile version 4, response trim, trace v3. */
#define DTHC_AUTO_FW_REV            23u
#define DTHC_PROFILE_V4_BYTES       81u
#define DTHC_PROFILE_BYTES          dthc_profile_length(__comp_inst)
#define DTHC_PROFILE_PAGE_BYTES     28u
#define DTHC_PROFILE_PAGE_COUNT     3u

#define DTHC_PROFILE_NONE           0u
#define DTHC_PROFILE_READ           1u
#define DTHC_PROFILE_WRITE          2u
#define DTHC_PROFILE_COMMIT         3u

typedef struct {
    volatile uint32_t magic;
    volatile uint32_t abi_version;
    volatile uint32_t struct_size;
    volatile uint32_t bridge_state;
    volatile int32_t  bridge_error;
    volatile uint32_t request_seq;
    volatile uint32_t response_seq;
    volatile int32_t  response_status;
    volatile uint8_t  request_frame[DTHC_SPI_PACKET_SIZE];
    volatile uint8_t  response_frame[DTHC_SPI_PACKET_SIZE];
} dthc_bspi_bridge_shm_t;

static int dthc_bridge_shmem_id = -1;
static hal_stream_t dthc_voltage_stream;
static int dthc_voltage_stream_ready = 0;

